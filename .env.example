# Copy these names into Replit Secrets; do not commit real values.
HERMES_TENANT_ID=hermes-main
HERMES_SESSION_SECRET=generate-a-long-random-secret
HERMES_ADMIN_USER=change-me
HERMES_ADMIN_PASSWORD=use-a-unique-strong-password

# Optional:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# HERMES_API_TOKEN=
# HERMES_COOKIE_SECURE=true
