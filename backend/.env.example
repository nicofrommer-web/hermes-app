# Required server-side secrets. Never place these values in frontend code.
HERMES_TENANT_ID=hermes-internal
HERMES_SESSION_SECRET=replace-with-at-least-32-random-bytes
HERMES_ADMIN_USER=admin
HERMES_ADMIN_PASSWORD=replace-with-a-long-unique-password
# Production must use HTTPS; keep true. Set false only for local HTTP development.
HERMES_COOKIE_SECURE=true
# Managed PostgreSQL recommended for deployment.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/hermes
# Optional service-to-service token; do not expose it to the browser.
HERMES_API_TOKEN=
