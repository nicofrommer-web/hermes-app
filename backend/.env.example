# Production environment example
# Copy to .env and fill in, or set as Fly.io secrets

HERMES_TENANT_ID=hermes-main
HERMES_SESSION_SECRET=change-me-to-a-long-random-string
HERMES_ADMIN_USER=admin
HERMES_ADMIN_PASSWORD=change-me-to-strong-password
HERMES_COOKIE_SECURE=true
HERMES_API_TOKEN=optional-bearer-token-for-api

# Set automatically by `fly postgres attach`
# DATABASE_URL=postgresql://...
