# Generate a long random secret and store it in your hosting provider's secret manager.
HERMES_API_TOKEN=replace-with-a-long-random-secret
# Unique tenant identifier for this isolated first deployment.
HERMES_TENANT_ID=hermes-internal
# Use a managed PostgreSQL URL for deployment; SQLite is only for local development.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/hermes
# Comma-separated exact frontend origins; leave empty until the frontend is deployed.
HERMES_ALLOWED_ORIGINS=
